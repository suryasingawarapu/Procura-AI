# Provenance-Aware Shared Memory - Environment Variables
# Copy to .env and fill in values (never commit .env)

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# API Authentication (required for FastAPI endpoints)
# If unset, API auth fails closed (503)
MEMORY_API_TOKEN=your-api-token
# Let the bundled browser UI (/app) call the API without the browser ever
# holding a token: the server uses MEMORY_API_TOKEN on its behalf, but only
# for requests from this machine (loopback peer + loopback Host/Origin).
# Leave off for any deployment behind a reverse proxy.
UI_LOCAL_AUTH=0

# Optional: Writes for legacy scripts
MEMORY_ALLOW_WRITE=0

# Optional: Embeddings (M3/M5)
OPENAI_API_KEY=your-openai-api-key

# Optional: Observability (M6)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
# One slug for this project: used in trace names, tags and metadata (see langfuse.md)
AGENT_ID=procurement-coordinator
ENVIRONMENT=development
# 0 switches tracing off; LANGFUSE_CAPTURE_CONTENT=0 sends no prompt/reply text to Langfuse
LANGFUSE_ENABLED=1
LANGFUSE_CAPTURE_CONTENT=1

# Optional: NVIDIA Nemotron (default LLM for the five-agent demo workflow)
NVIDIA_API_KEY=your-nvidia-api-key

# --- Procurement system (Vendra/Procura/Finora) -----------------------------
# Optional. Without these, the procurement API runs against the seeded,
# clearly-labeled in-memory ERPNext stand-in (app/procurement/mcp/client.py
# SeededERPNextClient) -- safe by default, no real ERPNext calls are ever made
# until all three of these are set.
ERPNEXT_URL=https://your-erpnext-site.example.com
ERPNEXT_API_KEY=your-erpnext-api-key
ERPNEXT_API_SECRET=your-erpnext-api-secret
# Optional, default off: even with ERPNext configured above, create_rfq /
# create_purchase_order still refuse to write unless this is also set.
ERPNEXT_ALLOW_WRITES=0
# Route ERPNext calls through Frappe's own built-in MCP endpoint
# (/api/v2/mcp, Frappe Core 16+) instead of plain REST -- the application's
# default backend. Verified live against a hosted Frappe Cloud site -- see
# app/procurement/mcp/client.py (FrappeMCPClient). Set to 0 to use plain
# REST (ERPNextRestClient) instead.
ERPNEXT_USE_OFFICIAL_MCP=1

# Optional, default off: an optional NVIDIA Nemotron subagent (one per
# system, via app.agents.workflow.get_llm) that narrates each system's
# already-deterministically-computed result in plain language
# (payload["ai_summary"]) -- never used to decide compliance, a
# recommendation, or a budget verdict. See app/procurement/narration.py.
PROCUREMENT_AI_SUMMARIES=0

# Optional: per-system scoped API tokens (same mechanism as the five-agent
# demo's MEMORY_API_TOKEN_<AGENT>) -- grants a token access to only that
# system's own memory/resources instead of every system.
MEMORY_API_TOKEN_VENDRA=your-vendra-scoped-token
MEMORY_API_TOKEN_PROCURA=your-procura-scoped-token
MEMORY_API_TOKEN_FINORA=your-finora-scoped-token

# --- Vendor email via Composio Gmail ---
# Consumer key from the Composio dashboard; sent in the x-consumer-api-key header of the MCP endpoint.
COMPOSIO_API_KEY=
# The connected Gmail account id/alias to send from (never let it default).
COMPOSIO_GMAIL_ACCOUNT=
# Nothing is sent unless this is 1. Drafting is always allowed.
MAIL_ALLOW_SEND=0
# When set, EVERY mail goes to this address instead of the vendor (use while testing).
MAIL_TEST_RECIPIENT=
MAIL_FOLLOWUP_DAYS=3
MAIL_MAX_FOLLOWUPS=2
