# Provenance-Aware Shared Memory - Environment Variables
# Copy to .env and fill in values (never commit .env)

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# API Authentication (required for FastAPI endpoints)
# If unset, API auth fails closed (503)
MEMORY_API_TOKEN=your-api-token

# Optional: Writes for legacy scripts
MEMORY_ALLOW_WRITE=0

# Optional: Embeddings (M3/M5)
OPENAI_API_KEY=your-openai-api-key

# Optional: Observability (M6)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
